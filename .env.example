# .env.example
GEMINI_API_KEY=

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# F1.3 — HMAC secret for OAuth state (any strong random string, e.g. `openssl rand -base64 32`)
OAUTH_STATE_SECRET=

# F1.4 — 32-byte key for AES-256-GCM token encryption at rest (64-char hex, e.g. `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY=

APP_URL=
